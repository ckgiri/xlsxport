{
  "name": "xlsxport",
  "version": "1.1.0",
  "description": "Export JSON to a real Excel .xlsx file in one call. Auto columns, widths, dates, number formats, links, formulas, multiple sheets. Zero dependencies, runs everywhere.",
  "keywords": [
    "excel",
    "xlsx",
    "export",
    "json",
    "spreadsheet",
    "sheetjs",
    "exceljs",
    "download",
    "report",
    "csv"
  ],
  "license": "MIT",
  "author": "CK Giri <ckgdev@gmail.com>",
  "funding": "https://github.com/ckgiri/xlsxport?sponsor=1",
  "homepage": "https://github.com/ckgiri/xlsxport",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckgiri/xlsxport.git"
  },
  "bugs": {
    "url": "https://github.com/ckgiri/xlsxport/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "exceljs": "^4.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
